# Custom Suricata Rules for Home SOC Lab

# Rule 1: Detect Nmap SYN scan
alert tcp any any -> $HOME_NET any (msg:"NMAP SYN Scan Detected"; flags:S; threshold: type both, track by_src, count 20, seconds 10; sid:1000001; rev:1;)

# Rule 2: Detect SSH brute force
alert tcp any any -> $HOME_NET 22 (msg:"SSH Brute Force Attempt"; flow:to_server,established; content:"SSH-"; threshold: type both, track by_src, count 5, seconds 60; sid:1000002; rev:1;)

# Rule 3: Detect DNS tunneling (long subdomain queries)
alert dns any any -> any any (msg:"Possible DNS Tunneling"; dns.query; content:"."; pcre:"/^[a-z0-9]{30,}\./"; sid:1000003; rev:1;)

# Rule 4: Detect HTTP C2 beaconing (regular intervals)
alert http any any -> $EXTERNAL_NET any (msg:"Possible C2 Beaconing"; http.method; content:"GET"; http.uri; content:"/api/"; threshold: type both, track by_src, count 10, seconds 300; sid:1000004; rev:1;)

# Rule 5: Detect SMB lateral movement
alert tcp any any -> $HOME_NET 445 (msg:"SMB Lateral Movement Attempt"; flow:to_server,established; content:"|ff|SMB"; sid:1000005; rev:1;)

# Rule 6: Detect PowerShell download cradle
alert http any any -> $EXTERNAL_NET any (msg:"PowerShell Download Cradle"; http.uri; content:"Invoke-WebRequest"; nocase; sid:1000006; rev:1;)

# Rule 7: Detect ICMP tunneling (large payloads)
alert icmp any any -> any any (msg:"Possible ICMP Tunneling"; dsize:>100; sid:1000007; rev:1;)

# Rule 8: Detect port scan (multiple ports)
alert tcp any any -> $HOME_NET any (msg:"Port Scan Detected"; flags:S; threshold: type both, track by_src, count 15, seconds 10; sid:1000008; rev:1;)