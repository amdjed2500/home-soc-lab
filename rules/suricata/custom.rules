# Custom Suricata Rules for Home SOC Lab
# NOTE: These are heuristic rules with documented limitations.
# See comments for what each rule actually detects vs. what it claims.

# Rule 1: Detect Nmap SYN scan (merged with port scan detection)
alert tcp any any -> $HOME_NET any (msg:"NMAP SYN Scan Detected"; flags:S; threshold: type both, track by_src, count 15, seconds 10; sid:1000001; rev:2;)

# Rule 2: Detect suspicious SSH connection activity (connection-rate heuristic)
# LIMITATION: This detects rapid SSH connection attempts, NOT failed authentication.
# SSH authentication is encrypted; use endpoint auth logs for failed-login detection.
alert tcp any any -> $HOME_NET 22 (msg:"Suspicious SSH Connection Activity"; flow:to_server; flags:S; threshold: type both, track by_src, count 5, seconds 60; sid:1000002; rev:3;)

# Rule 3: Detect DNS tunneling (long subdomain labels — heuristic, may produce FPs)
# LIMITATION: Long labels alone are not high entropy. Combine with entropy analysis for accuracy.
alert dns any any -> any any (msg:"Possible DNS Tunneling (long label heuristic)"; dns.query; content:"."; pcre:"/^[a-z0-9]{20,}\./"; threshold: type both, track by_src, count 10, seconds 60; sid:1000003; rev:3;)

# Rule 4: Detect HTTP C2 beaconing (request threshold — not interval analysis)
# LIMITATION: This counts repeated GETs to /api/ paths. True beaconing requires interval analysis (see Zeek script).
alert http any any -> $EXTERNAL_NET any (msg:"Possible C2 Beaconing (request threshold)"; http.method; content:"GET"; http.uri; content:"/api/"; threshold: type both, track by_src, count 5, seconds 300; sid:1000004; rev:3;)

# Rule 5: Detect SMB lateral movement
alert tcp any any -> $HOME_NET 445 (msg:"SMB Lateral Movement Attempt"; flow:to_server,established; content:"|ff|SMB"; sid:1000005; rev:1;)

# Rule 6: Detect PowerShell download cradle (HTTP body heuristic)
# LIMITATION: Matching Invoke-WebRequest in HTTP body is a weak heuristic. Use endpoint logging for reliable detection.
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"PowerShell Download Cradle (HTTP body heuristic)"; file.data; content:"Invoke-WebRequest"; nocase; sid:1000006; rev:3;)

# Rule 7: Detect ICMP tunneling (large payloads)
alert icmp any any -> any any (msg:"Possible ICMP Tunneling"; dsize:>100; sid:1000007; rev:1;)

# NOTE: Rule 1000008 (port scan) was merged into 1000001 to avoid overlap.